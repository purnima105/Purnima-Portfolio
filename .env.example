# ==============================================================================
# Environment Variables for Purnima Gupta Portfolio
# Configure these variables in Vercel Project Settings > Environment Variables
# NEVER commit the real .env file with active credentials to source control!
# ==============================================================================

# Supabase PostgreSQL Configuration
# Found in Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Resend Email Delivery Configuration
# Found in Resend Dashboard > API Keys
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Email Notification Routing
# Destination email for portfolio inquiries (Owner's verified email)
CONTACT_TO_EMAIL=gpurnima966@gmail.com

# Verified sender email on Resend (e.g., notifications@purnimagupta.com.np or onboarding@resend.dev during testing)
CONTACT_FROM_EMAIL=Portfolio Inquiries <notifications@purnimagupta.com.np>
